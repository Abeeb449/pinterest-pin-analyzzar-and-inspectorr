# ---- Required ----
# Password that gates the whole app (login screen checks against this).
APP_PASSWORD=change-me

# Secret used to sign the login session cookie. Use a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Optional (Phase 2 reliability lever — LEAVE UNSET to start) ----
# The `_pinterest_sess` cookie value from a logged-in THROWAWAY (not your main)
# Pinterest session. Improves reliability but raises blocking/exposure risk.
# The app runs fine in anonymous mode when this is empty.
PINTEREST_SESS_COOKIE=

# The `csrftoken` cookie value, paired with the session cookie above.
PINTEREST_CSRF_TOKEN=

# ---- Optional tuning ----
# Base delay (seconds) between outbound Pinterest requests.
PINTEREST_REQUEST_DELAY=1.0
